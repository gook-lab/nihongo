# Firebase Configuration
# 1. Firebase Console (https://console.firebase.google.com)에서 프로젝트 생성
# 2. 프로젝트 설정 > 일반 > 내 앱 > 웹 앱 추가
# 3. Firebase SDK snippet에서 아래 값들 복사

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# 소셜 로그인 설정
#
# [Google 로그인]
# Firebase Console > Authentication > Sign-in method > Google 활성화
#
# [카카오 로그인] (OIDC 설정 필요)
# 1. Kakao Developers에서 앱 등록
# 2. Firebase Console > Authentication > Sign-in method > OpenID Connect 추가
#    - Provider name: kakao
#    - Client ID: 카카오 앱의 REST API 키
#    - Issuer URL: https://kauth.kakao.com
#
# [네이버 로그인] (OIDC 설정 필요)
# 1. 네이버 개발자 센터에서 앱 등록
# 2. Firebase Console > Authentication > Sign-in method > OpenID Connect 추가
#    - Provider name: naver
#    - Client ID: 네이버 앱의 Client ID
#    - Issuer URL: https://nid.naver.com

# Murf.ai TTS API (https://murf.ai/api/dashboard)
# 자연스러운 일본어 음성 합성을 위한 API
VITE_MURF_API_KEY=your-murf-api-key

# AI Chat (Google Gemini) - 무료
# AI 일본어 튜터 기능을 위한 API
# https://aistudio.google.com/app/apikey 에서 API 키 발급
VITE_GEMINI_API_KEY=your-gemini-api-key

# GlitchTip 오류 트래킹 (선택, Sentry SDK 호환)
# 비워두면 no-op 모드 (개발/미리보기에서 안전).
# https://app.glitchtip.com 에서 프로젝트 생성 → Projects → 프로젝트 → SDK Setup의 DSN 복사
# 형식: https://<key>@app.glitchtip.com/<projectId>
VITE_SENTRY_DSN=
# 배포 추적용 (선택). package.json 버전이나 git sha를 넣어도 됨.
VITE_APP_VERSION=
